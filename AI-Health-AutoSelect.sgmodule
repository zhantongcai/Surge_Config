#!name=AI Health Auto Select Mac - AI 节点自动优选 v1.2.4
#!desc=版本 v1.2.4。Mac 专版：每 6 小时自动检测一次；从 AI、美国、日本、新加坡、台湾、英国、韩国候选组中测试节点，先用 ChatGPT Cloudflare trace 判断出口地区，再用 chatgpt.com 后端接口确认可用性，并自动切换 AI 组到最快可用节点。
#!author=zhantongcai
#!homepage=https://github.com/zhantongcai/Surge_Config
#!system=mac

[Script]
ai-health-autoselect = type=cron,cronexp="0 */6 * * *",timeout=90,script-path=https://raw.githubusercontent.com/zhantongcai/Surge_Config/main/ai-health-autoselect.js
