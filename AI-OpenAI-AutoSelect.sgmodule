#!name=AI OpenAI Auto Select
#!desc=Periodically test AI candidate policies against OpenAI API and select the fastest usable policy for the AI group.
#!system=iOS
#!requirement=CORE_VERSION>=20

[Script]
AI OpenAI Auto Select = type=cron,cronexp="*/10 * * * *",timeout=60,script-path=https://raw.githubusercontent.com/zhantongcai/Surge_Config/main/ai-openai-autoselect.js,argument=group=AI&source=AI&url=https%3A%2F%2Fapi.openai.com%2Fv1%2Fmodels
